def cadastrar(nomeLivro, autorLivro, anoLivro):
  cursor.execute(
      "INSERT INTO banco_livros (nome, autor, ano) VALUES (?,?,?)",
      (nomeLivro, autorLivro, anoLivro),
  )
  conexao.commit()


